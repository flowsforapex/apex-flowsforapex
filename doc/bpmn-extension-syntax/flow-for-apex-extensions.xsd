    <!-- Process-Level Attributes -->
    <xs:attribute name="isCallable" type="apex:BooleanString">
        <xs:annotation>
            <xs:documentation>Whether process can be called by other processes via Call Activity</xs:documentation>
        </xs:annotation>
    </xs:attribute>
    
    <xs:attribute name="isStartable" type="apex:BooleanString">
        <xs:annotation>
            <xs:documentation>Whether process can be started directly (via API or UI)</xs:documentation>
        </xs:annotation>
    </xs:attribute>
    
    <xs:attribute name="manualInput" type="apex:BooleanString">
        <xs:annotation>
            <xs:documentation>Legacy attribute for manual data entry mode</xs:documentation>
        </xs:annotation>
    </xs:attribute>
    
    <xs:attribute name="minLoggingLevel" type="apex:LoggingLevelEnum">
        <xs:annotation>
            <xs:documentation>Minimum logging level for this process (off, error, warn, info, debug)</xs:documentation>
        </xs:annotation>
    </xs:attribute>
    
    <xs:attribute name="instanceName" type="xs:string">
        <xs:annotation>
            <xs:documentation>Expression for process instance name (supports process variable substitution)</xs:documentation>
        </xs:annotation>
    </xs:attribute>
    
    <xs:attribute name="applicationId" type="xs:string">
        <xs:annotation>
            <xs:documentation>Default APEX application ID for tasks in this process</xs:documentation>
        </xs:annotation>
    </xs:attribute>
    
    <xs:attribute name="pageId" type="xs:string">
        <xs:annotation>
            <xs:documentation>Default APEX page ID for tasks in this process</xs:documentation>
        </xs:annotation>
    </xs:attribute>
    
    <xs:attribute name="username" type="xs:string">
        <xs:annotation>
            <xs:documentation>Process username/creator</xs:documentation>
        </xs:annotation>
    </xs:attribute>
    
    <xs:attribute name="businessAdmin" type="xs:string">
        <xs:annotation>
            <xs:documentation>Business administrator for this process</xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <!-- Task-Level Attributes -->
    <xs:attribute name="type" type="apex:TaskTypeEnum">
        <xs:annotation>
            <xs:documentation>Type of user task (apexPage, apexApproval, apexSimpleForm, simpleMessage, externalUrl)</xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <!-- Call Activity Attributes -->
    <xs:attribute name="calledDiagram" type="xs:string">
        <xs:annotation>
            <xs:documentation>Name of the diagram to call</xs:documentation>
        </xs:annotation>
    </xs:attribute>
    
    <xs:attribute name="calledDiagramVersionSelection" type="apex:VersionSelectionEnum">
        <xs:annotation>
